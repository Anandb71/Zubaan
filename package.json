{
  "name": "zubaan",
  "version": "0.2.0",
  "private": true,
  "description": "Evidence-backed compliance for multilingual sales and support conversations across voice, email, WhatsApp, chat, and imported transcripts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"lib/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke-live.ts",
    "doctor": "tsx scripts/doctor.ts",
    "seed": "tsx scripts/seed.ts",
    "db:dry-run": "tsx scripts/push-migrations.ts --dry-run",
    "db:push": "tsx scripts/push-migrations.ts",
    "verify": "npm run type-check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.21.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.23",
    "supabase": "^2.109.1",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
