# Sarvam — required for live STT / 30B / 105B / TTS
SARVAM_API_KEY=

# Optional overrides
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
# ZUBAAN_FORCE_MOCK=false

# Supabase — optional; app runs fully in memory without these
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fixed workspace scope until authentication is enabled
ZUBAAN_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# Migration tooling only — never expose these to the app or browser
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
